    <string name="settings_connectors_title">Verbindungen</string>
    <string name="settings_connectors_hint">Verbinde die Apps und Dienste, aus denen Diafit Daten beziehen soll. Du kannst beliebig viele verbinden und legst dann fest, welche jeweils welche Datenart liefert.</string>
